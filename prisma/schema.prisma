generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AppSnapshot {
  id        String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TmdbCacheEntry {
  key       String   @id
  kind      String
  payload   Json
  fetchedAt DateTime @default(now())
  expiresAt DateTime

  @@index([kind, expiresAt])
}

model UserRecord {
  id           String         @id
  name         String
  username     String         @unique
  email        String
  avatarSeed   String?
  avatarUrl    String?
  passwordHash String
  isAdmin      Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  ratings      RatingRecord[]

  @@index([username])
}

model MovieRecord {
  id                String                  @id
  slug              String                  @unique
  data              Json
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  pendingEntries    PendingMovie[]
  watchEntry        WatchEntryRecord?
  ratings           RatingRecord[]
  weeklyItems       WeeklyBatchItemRecord[]
  selectedInBatches WeeklyBatchRecord[]

  @@index([slug])
}

model PendingMovie {
  groupId String
  movieId String
  addedAt DateTime    @default(now())
  movie   MovieRecord @relation(fields: [movieId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([groupId, movieId])
  @@index([groupId, addedAt])
  @@index([movieId])
}

model WatchEntryRecord {
  id              String      @id
  movieId         String      @unique
  groupId         String
  watchedOn       DateTime?
  selectedForWeek String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  movie           MovieRecord @relation(fields: [movieId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([groupId, watchedOn])
}

model RatingRecord {
  id        String      @id
  movieId   String
  userId    String
  score     Float
  comment   String?
  watchedOn DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  movie     MovieRecord @relation(fields: [movieId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user      UserRecord  @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([movieId, userId])
  @@index([movieId])
  @@index([userId])
}

model WeeklyBatchRecord {
  id              String                  @id
  groupId         String
  weekOf          DateTime
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  selectedMovieId String?
  items           WeeklyBatchItemRecord[]
  selectedMovie   MovieRecord?            @relation(fields: [selectedMovieId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([groupId, createdAt])
  @@index([selectedMovieId])
}

model WeeklyBatchItemRecord {
  id       String            @id
  batchId  String
  movieId  String
  position Int               @default(0)
  score    Float
  summary  String
  reasons  Json
  metrics  Json?
  batch    WeeklyBatchRecord @relation(fields: [batchId], references: [id], onDelete: Cascade)
  movie    MovieRecord       @relation(fields: [movieId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([batchId, position])
  @@index([movieId])
}
